# Copia este archivo a .env y ajusta los valores.

# Base de datos (SQLite por default, no requiere instalar nada)
DATABASE_URL=sqlite:///./ferreteria.db

# Carpeta con products.csv / stores.csv / sales.csv
DATA_DIR=../data

# --- Google Gemini (opcional) ---
# Sin esta key, el sistema sigue funcionando 100% con el motor de reglas
# + co-ocurrencia (no es un requisito duro, es un enriquecimiento).
# Consíguela gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS: origen del frontend
FRONTEND_ORIGIN=http://localhost:3000

# Pesos del motor combinado de recomendación (deben sumar ~1 junto con el
# resto; ver README.md "Motor de recomendación" para la justificación)
WEIGHT_LLM_RULES=0.45
WEIGHT_COOCCURRENCE=0.40
WEIGHT_MANUAL_BOOST=0.15
CLIMATE_BOOST_FACTOR=1.3
CLIMATE_PENALTY_FACTOR=0.6

TOP_K_RECOMMENDATIONS=5
